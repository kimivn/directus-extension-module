{
  "name": "directus-extension-module",
  "version": "1.0.0",
  "description": "A custom administrative dashboard for Directus to manage order data.",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension dev",
    "link": "directus-extension link",
    "validate": "directus-extension validate",
    "test": "vitest",
    "coverage": "vitest run --coverage"
  },
  "keywords": [
    "directus",
    "directus-extension",
    "directus-extension-module"
  ],
  "directus:extension": {
    "type": "module",
    "path": "dist/index.js",
    "source": "src/index.ts",
    "host": "^11.0.0"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "directus": "^11.14.0",
    "pinia": "^2.3.1",
    "vue-chartjs": "^5.3.3",
    "vue-virtual-scroller": "^2.0.0-beta.8"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "17.0.4",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.17",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^27.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17",
    "vue": "^3.5.26"
  }
}
